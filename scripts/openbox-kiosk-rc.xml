<?xml version="1.0" encoding="UTF-8"?>
<!-- PrintBooth Kiosk Window Manager Configuration (Openbox) -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <resistance>
    <strength>10</strength>
    <screen_edge_strength>20</screen_edge_strength>
  </resistance>
  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
  </focus>
  <placement>
    <policy>Smart</policy>
    <center>yes</center>
  </placement>
  <theme>
    <name>Clearlooks</name>
    <titleLayout></titleLayout>
  </theme>
  
  <!-- Lock down all windows: no borders, no titlebars, forced fullscreen -->
  <applications>
    <application class="*">
      <decor>no</decor>
      <fullscreen>yes</fullscreen>
      <maximized>yes</maximized>
    </application>
    <!-- Chromium Kiosk Window: Always forced on top layer -->
    <application name="chromium-browser">
      <decor>no</decor>
      <layer>above</layer>
      <fullscreen>yes</fullscreen>
      <maximized>yes</maximized>
      <focus>yes</focus>
    </application>
    <application name="chromium">
      <decor>no</decor>
      <layer>above</layer>
      <fullscreen>yes</fullscreen>
      <maximized>yes</maximized>
      <focus>yes</focus>
    </application>
    <!-- Terminal Windows: Always elevated on top layer for technician maintenance -->
    <application class="*terminal*">
      <decor>yes</decor>
      <layer>above</layer>
      <fullscreen>yes</fullscreen>
      <focus>yes</focus>
    </application>
    <application name="*terminal*">
      <decor>yes</decor>
      <layer>above</layer>
      <fullscreen>yes</fullscreen>
      <focus>yes</focus>
    </application>
    <application class="XTerm">
      <decor>yes</decor>
      <layer>above</layer>
      <fullscreen>yes</fullscreen>
      <focus>yes</focus>
    </application>
    <!-- Suppress and bury any rogue authentication / system dialogs -->
    <application type="dialog">
      <decor>no</decor>
      <layer>below</layer>
      <iconic>yes</iconic>
      <focus>no</focus>
    </application>
    <application class="*polkit*">
      <decor>no</decor>
      <layer>below</layer>
      <iconic>yes</iconic>
      <focus>no</focus>
    </application>
    <application class="*keyring*">
      <decor>no</decor>
      <layer>below</layer>
      <iconic>yes</iconic>
      <focus>no</focus>
    </application>
    <application class="*pinentry*">
      <decor>no</decor>
      <layer>below</layer>
      <iconic>yes</iconic>
      <focus>no</focus>
    </application>
  </applications>

  <!-- Disable all mouse actions on root desktop (No right-click menu, no middle-click menu) -->
  <mouse>
    <context name="Root">
      <!-- Empty: Zero desktop menu on touch or right-click -->
    </context>
  </mouse>

  <!-- Restrict keyboard shortcuts (Allow only technician escape & Wi-Fi configuration keys) -->
  <keyboard>
    <keybind key="C-A-S-q">
      <action name="Exit" />
    </keybind>
    <keybind key="C-A-w">
      <action name="Execute">
        <command>/bin/bash -c "if [ -x /usr/local/bin/printbooth-wifi ]; then /usr/local/bin/printbooth-wifi; else curl -s http://localhost:5175/api/wifi; fi"</command>
      </action>
    </keybind>
    <keybind key="C-A-W">
      <action name="Execute">
        <command>/bin/bash -c "if [ -x /usr/local/bin/printbooth-wifi ]; then /usr/local/bin/printbooth-wifi; else curl -s http://localhost:5175/api/wifi; fi"</command>
      </action>
    </keybind>
    <keybind key="F12">
      <action name="Execute">
        <command>/bin/bash -c "if [ -x /usr/local/bin/printbooth-wifi ]; then /usr/local/bin/printbooth-wifi; else curl -s http://localhost:5175/api/wifi; fi"</command>
      </action>
    </keybind>
    <keybind key="C-A-t">
      <action name="Execute">
        <command>/bin/bash -c "if [ -x /usr/local/bin/printbooth-wifi ]; then /usr/local/bin/printbooth-wifi; else curl -s http://localhost:5175/api/wifi; fi"</command>
      </action>
    </keybind>
  </keyboard>
</openbox_config>
