<?xml version="1.0" encoding="UTF-8"?>
<!-- PrintBooth Kiosk Window Manager Configuration (Openbox) -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <resistance>
    <strength>10</strength>
    <screen_edge_strength>20</screen_edge_strength>
  </resistance>
  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
  </focus>
  <placement>
    <policy>Smart</policy>
    <center>yes</center>
  </placement>
  <theme>
    <name>Clearlooks</name>
    <titleLayout></titleLayout>
  </theme>
  
  <!-- Lock down all windows: no borders, no titlebars, forced fullscreen -->
  <applications>
    <application class="*">
      <decor>no</decor>
      <fullscreen>yes</fullscreen>
      <maximized>yes</maximized>
    </application>
    <!-- Chromium Kiosk Window: Always forced on top layer -->
    <application name="chromium-browser">
      <decor>no</decor>
      <layer>above</layer>
      <fullscreen>yes</fullscreen>
      <maximized>yes</maximized>
      <focus>yes</focus>
    </application>
    <application name="chromium">
      <decor>no</decor>
      <layer>above</layer>
      <fullscreen>yes</fullscreen>
      <maximized>yes</maximized>
      <focus>yes</focus>
    </application>
    <!-- Suppress and bury any rogue authentication / system dialogs -->
    <application type="dialog">
      <decor>no</decor>
      <layer>below</layer>
      <iconic>yes</iconic>
      <focus>no</focus>
    </application>
    <application class="*polkit*">
      <decor>no</decor>
      <layer>below</layer>
      <iconic>yes</iconic>
      <focus>no</focus>
    </application>
    <application class="*keyring*">
      <decor>no</decor>
      <layer>below</layer>
      <iconic>yes</iconic>
      <focus>no</focus>
    </application>
    <application class="*pinentry*">
      <decor>no</decor>
      <layer>below</layer>
      <iconic>yes</iconic>
      <focus>no</focus>
    </application>
  </applications>

  <!-- Disable all mouse actions on root desktop (No right-click menu, no middle-click menu) -->
  <mouse>
    <context name="Root">
      <!-- Empty: Zero desktop menu on touch or right-click -->
    </context>
  </mouse>

  <!-- Restrict keyboard shortcuts (Allow only technician escape & Wi-Fi configuration keys) -->
  <keyboard>
    <keybind key="C-A-S-q">
      <action name="Exit" />
    </keybind>
    <keybind key="C-A-w">
      <action name="Execute">
        <command>x-terminal-emulator -e sudo /home/pi/printer_automation/kiosk/scripts/exit_kiosk_wifi.sh</command>
      </action>
    </keybind>
  </keyboard>
</openbox_config>
