[Unit]
Description=PrintBooth Kiosk Brain IoT Daemon
After=network-online.target cups.service
Wants=network-online.target cups.service

[Service]
Type=simple
User=kiosk
WorkingDirectory=/home/kiosk/kiosk/brain
ExecStart=/home/kiosk/kiosk/brain/venv/bin/python ws_kiosk_client.py
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
EnvironmentFile=-/home/kiosk/kiosk/.env

[Install]
WantedBy=multi-user.target
