# PrintBooth Kiosk Brain & Touchscreen Terminal (Raspberry Pi)
# =============================================================

# Unique hardware kiosk station ID (e.g. PB-001, PB-002)
KIOSK_ID=PB-001

# Friendly station name
KIOSK_NAME=PrintBooth — Test Station

# Central PrintBooth Backend API URL
# If running locally on same machine/LAN: http://192.168.1.X:5000/api
# If production: https://api.printbooth.in/api
PRINTBOOTH_API_URL=http://localhost:5000/api

# Physical printer name as configured in CUPS (run `lpstat -p` on the Pi to check)
# Leave blank or "auto" to use default CUPS printer
PRINTER_NAME=auto

# Polling interval for new print jobs (in seconds)
POLL_INTERVAL_SECONDS=3

# Heartbeat telemetry reporting interval (in seconds)
HEARTBEAT_INTERVAL_SECONDS=10

# Temporary storage directory for downloaded print documents
TEMP_JOBS_DIR=/tmp/printbooth_jobs

# Web URL for QR code generation (point to your customer web upload app)
CLIENT_WEB_URL=http://localhost:5200/print?id=PB-001
